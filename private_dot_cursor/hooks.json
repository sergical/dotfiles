{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "/bin/sh -c 'f=$HOME/.agents/hooks/machine-load-gate.py; o=$([ -f \"$f\" ] && python3 -I \"$f\"); [ -n \"$o\" ] && printf \"%s\" \"$o\" || printf \"%s\" \"{\\\"permission\\\":\\\"allow\\\"}\"'",
        "timeout": 270
      }
    ]
  }
}
