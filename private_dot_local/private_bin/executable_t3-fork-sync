#!/bin/bash
# Keeps "T3 Code (Fork)" on the newest upstream T3 Code nightly plus the fork's commits.
#   t3-fork-sync          rebase onto the newest nightly, check, build, install when the app is closed
#   t3-fork-sync install  install a staged build now (quit the fork app first)
set -euo pipefail

export PATH="$HOME/.vite-plus/bin:$HOME/.cargo/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin"

repo="${T3_FORK_REPO:-$HOME/src/t3code-fork}"
branch="fork-nightly"
app_name="T3 Code (Fork)"
app="/Applications/$app_name.app"
state="$HOME/.t3-fork/sync"
staged="$state/staged.dmg"
mkdir -p "$state"

log() { echo "$(date '+%F %T') $*"; }
notify() { osascript -e "display notification \"$1\" with title \"$app_name\"" >/dev/null 2>&1 || true; }
fail() {
  log "FAIL: $1"
  notify "$1"
  exit 1
}

lock="$state/lock"
if ! mkdir "$lock" 2>/dev/null; then
  if kill -0 "$(cat "$lock/pid" 2>/dev/null)" 2>/dev/null; then
    log "another sync is running"
    exit 0
  fi
  rm -rf "$lock" && mkdir "$lock"
fi
echo $$ >"$lock/pid"
trap 'rm -rf "$lock"' EXIT

app_running() {
  [ "$(osascript -e 'application id "com.t3tools.t3code.fork" is running' 2>/dev/null)" = true ]
}

install_staged() {
  [ -f "$staged" ] || return 0
  if app_running; then
    log "staged $(cat "$state/staged") waits for $app_name to quit"
    notify "Update $(cat "$state/staged") is ready. Quit the app and run t3-fork-sync install."
    return 0
  fi
  local mount
  mount="$(mktemp -d)"
  hdiutil attach -quiet -nobrowse -readonly -mountpoint "$mount" "$staged"
  rm -rf "$app.incoming"
  ditto "$mount/$app_name.app" "$app.incoming"
  hdiutil detach -quiet "$mount"
  rm -rf "$app"
  mv "$app.incoming" "$app"
  mv "$state/staged" "$state/installed"
  rm -f "$staged"
  log "installed $(cat "$state/installed")"
  notify "Updated to $(cat "$state/installed")"
}

if [ "${1-}" = "install" ]; then
  install_staged
  exit 0
fi

cd "$repo"
[ "$(git branch --show-current)" = "$branch" ] || fail "$repo is not on $branch"
git diff --quiet && git diff --cached --quiet || fail "$repo has uncommitted changes"

git fetch origin --tags --quiet
tag="$(git tag -l 'v*-nightly.*' | awk -F. '{print $NF" "$0}' | sort -n | tail -1 | cut -d' ' -f2)"
base="$(git describe --tags --abbrev=0 --match 'v*-nightly.*' HEAD)"

if [ "$tag" != "$base" ]; then
  log "rebasing $branch from $base onto $tag"
  if ! git rebase --quiet --onto "$tag" "$base" "$branch"; then
    git rebase --abort
    fail "Fork commits conflict with $tag. The fork stays on $base."
  fi
fi

want="$tag+$(git rev-parse --short HEAD)"
for done_file in installed staged failed; do
  if [ "$(cat "$state/$done_file" 2>/dev/null)" = "$want" ]; then
    [ "$done_file" = staged ] && install_staged
    exit 0
  fi
done

log "building $want"
vp install --frozen-lockfile >/dev/null || { echo "$want" >"$state/failed"; fail "Install failed for $want"; }
if [ "$(git rev-list --count "$tag..HEAD")" -gt 0 ]; then
  node scripts/check-changed.ts "$tag" || { echo "$want" >"$state/failed"; fail "Checks failed for $want"; }
fi

set -a
. ./.env.example
set +a
unset GITHUB_REPOSITORY T3CODE_DESKTOP_UPDATE_REPOSITORY
out="$state/build"
rm -rf "$out"
node scripts/build-desktop-artifact.ts --platform mac --target dmg --arch arm64 \
  --build-version "${tag#v}" --signed --output-dir "$out" ||
  { echo "$want" >"$state/failed"; fail "Build failed for $want"; }

dmg="$(find "$out" -maxdepth 1 -name '*.dmg' | head -1)"
[ -n "$dmg" ] || { echo "$want" >"$state/failed"; fail "Build made no DMG for $want"; }
mv "$dmg" "$staged"
echo "$want" >"$state/staged"
rm -rf "$out"
log "staged $want"
install_staged
