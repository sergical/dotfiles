#!/bin/bash
# Keeps "T3 Code (Fork)" on the newest upstream T3 Code nightly plus the fork's commits.
# Rebases onto the newest nightly, checks, builds, and publishes a GitHub prerelease.
# The installed app finds that release and updates itself, like the official nightly.
set -euo pipefail

export PATH="$HOME/.vite-plus/bin:$HOME/.cargo/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin"

repo="${T3_FORK_REPO:-$HOME/src/t3code-fork}"
branch="fork-nightly"
app_name="T3 Code (Fork)"
release_repo="${T3_FORK_RELEASE_REPO:-sergical/t3code}"
state="$HOME/.t3-fork/sync"
mkdir -p "$state"

log() { echo "$(date '+%F %T') $*"; }
notify() { osascript -e "display notification \"$1\" with title \"$app_name\"" >/dev/null 2>&1 || true; }
fail() {
  log "FAIL: $1"
  notify "$1"
  exit 1
}

lock="$state/lock"
if ! mkdir "$lock" 2>/dev/null; then
  if kill -0 "$(cat "$lock/pid" 2>/dev/null)" 2>/dev/null; then
    log "another sync is running"
    exit 0
  fi
  rm -rf "$lock" && mkdir "$lock"
fi
echo $$ >"$lock/pid"
trap 'rm -rf "$lock"' EXIT

cd "$repo"
[ "$(git branch --show-current)" = "$branch" ] || fail "$repo is not on $branch"
git diff --quiet && git diff --cached --quiet || fail "$repo has uncommitted changes"

git fetch origin --tags --quiet
tag="$(git tag -l 'v*-nightly.*' | awk -F. '{print $NF" "$0}' | sort -n | tail -1 | cut -d' ' -f2)"
base="$(git describe --tags --abbrev=0 --match 'v*-nightly.*' HEAD)"

if [ "$tag" != "$base" ]; then
  log "rebasing $branch from $base onto $tag"
  if ! git rebase --quiet --onto "$tag" "$base" "$branch"; then
    git rebase --abort
    fail "Fork commits conflict with $tag. The fork stays on $base."
  fi
fi

want="$tag+$(git rev-parse --short HEAD)"
for done_file in published failed; do
  [ "$(cat "$state/$done_file" 2>/dev/null)" != "$want" ] || exit 0
done

log "building $want"
vp install --frozen-lockfile >/dev/null || { echo "$want" >"$state/failed"; fail "Install failed for $want"; }
if [ "$(git rev-list --count "$tag..HEAD")" -gt 0 ]; then
  node scripts/check-changed.ts "$tag" || { echo "$want" >"$state/failed"; fail "Checks failed for $want"; }
fi

set -a
. ./.env.example
[ ! -f "$state/notary.env" ] || . "$state/notary.env"
set +a
unset GITHUB_REPOSITORY
export T3CODE_DESKTOP_UPDATE_REPOSITORY="$release_repo"
out="$state/build"
rm -rf "$out"
node scripts/build-desktop-artifact.ts --platform mac --target dmg --arch arm64 \
  --build-version "${tag#v}" --signed --output-dir "$out" ||
  { echo "$want" >"$state/failed"; fail "Build failed for $want"; }

assets=()
while IFS= read -r file; do assets+=("$file"); done < <(
  find "$out" -maxdepth 1 \( -name '*.dmg' -o -name '*.zip' -o -name '*.blockmap' -o -name 'nightly-mac.yml' \)
)
[ "${#assets[@]}" -eq 5 ] || { echo "$want" >"$state/failed"; fail "Build made ${#assets[@]} of 5 release files for $want"; }

publish() {
  git -c credential.helper= -c credential.helper='!gh auth git-credential' \
    push --quiet --force "https://github.com/$release_repo.git" "HEAD:refs/heads/$branch" || return
  if gh release view "$tag" --repo "$release_repo" >/dev/null 2>&1; then
    gh release upload "$tag" "${assets[@]}" --repo "$release_repo" --clobber
  else
    gh release create "$tag" "${assets[@]}" --repo "$release_repo" --target "$(git rev-parse HEAD)" \
      --prerelease --latest=false --title "$app_name ${tag#v}" \
      --notes "Upstream $tag plus the fork commits:"$'\n'"$(git log --reverse --format='- %s' "$tag..HEAD")"
  fi
}
publish || { echo "$want" >"$state/failed"; fail "Publish failed for $want"; }
echo "$want" >"$state/published"
rm -rf "$out"
log "published $want to $release_repo"

gh release list --repo "$release_repo" --limit 100 --json tagName,createdAt \
  --jq 'sort_by(.createdAt) | reverse | .[5:][].tagName' |
  while IFS= read -r old; do
    gh release delete "$old" --repo "$release_repo" --yes --cleanup-tag && log "deleted old release $old"
  done
