#!/bin/bash
# Keeps "T3 fork" on the newest upstream T3 Code nightly plus the fork's commits.
# Rebases onto the newest nightly, checks, builds, and installs the app in /Applications.
# T3 fork has no update feed: while it runs, the build waits and installs after you quit it.
set -euo pipefail

export PATH="$HOME/.vite-plus/bin:$HOME/.cargo/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin"
# macOS gives TMPDIR as /var/..., a link to /private/var/.... Tests that compare a temp path
# with what Git prints (the real path) fail unless TMPDIR is already the real path.
TMPDIR="$(cd "${TMPDIR:-/tmp}" && pwd -P)/"
export TMPDIR

repo="${T3_FORK_REPO:-$HOME/src/t3code-fork}"
branch="t3-fork"
app_name="T3 fork"
state="$HOME/.t3-fork-lab/sync"
pending="$state/pending"
mkdir -p "$state"

log() { echo "$(date '+%F %T') $*"; }
notify() { osascript -e "display notification \"$1\" with title \"$app_name\"" >/dev/null 2>&1 || true; }
fail() {
  log "FAIL: $1"
  notify "$1"
  exit 1
}

exec 9>"$state/build.lock"
if ! /usr/bin/lockf -t 0 -s 9; then
  log "another sync is running"
  exit 0
fi

installer="$(dirname "$0")/t3-fork-install-pending"
"$installer"

cd "$repo"
[ "$(git branch --show-current)" = "$branch" ] || fail "$repo is not on $branch"
git diff --quiet && git diff --cached --quiet || fail "$repo has uncommitted changes"

git fetch origin --tags --quiet
tag="$(git tag -l 'v*-nightly.*' | awk -F. '{print $NF" "$0}' | sort -n | tail -1 | cut -d' ' -f2)"
base="$(git describe --tags --abbrev=0 --match 'v*-nightly.*' HEAD)"

# Fork commits that add dependencies touch pnpm-lock.yaml, which upstream changes often. When it
# is the only conflict, take the upstream lockfile and let pnpm add the fork's dependencies back.
resolve_lockfile() {
  [ "$(git diff --name-only --diff-filter=U)" = "pnpm-lock.yaml" ] || return 1
  git checkout --ours pnpm-lock.yaml &&
    vp install --lockfile-only >/dev/null &&
    git add pnpm-lock.yaml
}

rebase_onto_tag() {
  git rebase --quiet --onto "$tag" "$base" "$branch" && return 0
  while resolve_lockfile; do
    GIT_EDITOR=true git rebase --continue >/dev/null 2>&1 && return 0
  done
  return 1
}

if [ "$tag" != "$base" ]; then
  rebase_attempt="$tag+$(git rev-parse --short HEAD)"
  [ "$(cat "$state/rebase-failed" 2>/dev/null)" != "$rebase_attempt" ] || exit 0
  log "rebasing $branch from $base onto $tag"
  if ! rebase_onto_tag; then
    printf '%s\n' "$rebase_attempt" >"$state/rebase-failed"
    git rebase --abort
    fail "Fork commits conflict with $tag. The fork stays on $base."
  fi
fi

want="$tag+$(git rev-parse --short HEAD)"
for done_file in installed failed; do
  [ "$(cat "$state/$done_file" 2>/dev/null)" != "$want" ] || exit 0
done
[ "$(cat "$pending/version" 2>/dev/null)" != "$want" ] || exit 0

log "building $want"
vp install --frozen-lockfile >/dev/null || { echo "$want" >"$state/failed"; fail "Install failed for $want"; }
if [ "$(git rev-list --count "$tag..HEAD")" -gt 0 ]; then
  node scripts/check-changed.ts "$tag" || { echo "$want" >"$state/failed"; fail "Checks failed for $want"; }
fi

set -a
. ./.env.example
[ ! -f "$state/notary.env" ] || . "$state/notary.env"
set +a
# No update repository: the app gets no update feed, so it never fetches upstream builds.
unset GITHUB_REPOSITORY T3CODE_DESKTOP_UPDATE_REPOSITORY
# A -nightly version would brand the app "T3 fork (Nightly)" with the nightly icon.
version="$(echo "${tag#v}" | sed 's/-nightly\./-fork./')"
out="$state/build"
rm -rf "$out"
node scripts/build-desktop-artifact.ts --platform mac --target zip --arch arm64 \
  --build-version "$version" --signed --output-dir "$out" ||
  { echo "$want" >"$state/failed"; fail "Build failed for $want"; }

zip="$(find "$out" -maxdepth 1 -name '*.zip' | head -1)"
[ -n "$zip" ] || { echo "$want" >"$state/failed"; fail "Build made no app for $want"; }
staging="$(mktemp -d "$state/pending.XXXXXXXX")"
trap 'rm -rf "$staging"' EXIT
ditto -x -k "$zip" "$staging" || { echo "$want" >"$state/failed"; fail "Could not unpack $want"; }
[ -d "$staging/$app_name.app" ] || { echo "$want" >"$state/failed"; fail "The build for $want has no $app_name.app"; }
echo "$want" >"$staging/version"
(
  /usr/bin/lockf 8
  rm -rf "$pending"
  mv "$staging" "$pending"
) 8>"$state/install.lock"
rm -rf "$out"
log "built $want"

"$installer"
