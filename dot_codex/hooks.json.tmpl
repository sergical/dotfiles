{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c 'rex __internal session-start --agent codex --feature-session-naming=false 2>/dev/null || true'",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c 'f=$HOME/.agents/hooks/ui-review-reminder.py; [ -f \"$f\" ] && python3 -I \"$f\" || true'",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
