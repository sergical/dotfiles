{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "mcp__kody__execute"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "autoCompactWindow": 150000,
  "statusLine": {
    "type": "command",
    "command": "{{ .chezmoi.homeDir }}/.claude/bin/ccstatusline-autocompact",
    "padding": 0,
    "refreshInterval": 10
  },
  "enabledPlugins": {
    "sentry@claude-plugins-official": true,
    "plannotator@plannotator": true,
    "codex@openai-codex": true
  },
  "extraKnownMarketplaces": {
    "plannotator": {
      "source": {
        "source": "github",
        "repo": "backnotprop/plannotator"
      }
    },
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    }
  },
  "effortLevel": "xhigh",
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true,
  "theme": "dark"
}
