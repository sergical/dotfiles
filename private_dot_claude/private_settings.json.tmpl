{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "mcp__kody__execute"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "autoCompactWindow": 150000,
  "statusLine": {
    "type": "command",
    "command": "{{ .chezmoi.homeDir }}/.claude/bin/ccstatusline-autocompact",
    "padding": 0,
    "refreshInterval": 10
  },
  "enabledPlugins": {
    "sentry@claude-plugins-official": true,
    "plannotator@plannotator": true,
    "codex@openai-codex": true
  },
  "extraKnownMarketplaces": {
    "plannotator": {
      "source": {
        "source": "github",
        "repo": "backnotprop/plannotator"
      }
    },
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    }
  },
  "effortLevel": "xhigh",
  "tui": "fullscreen",
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "skillOverrides": {
    "animations": "user-invocable-only",
    "color": "user-invocable-only",
    "component-design": "user-invocable-only",
    "design-foundations": "user-invocable-only",
    "forms-and-inputs": "user-invocable-only",
    "marketing-pages": "user-invocable-only",
    "performance": "user-invocable-only",
    "surfaces": "user-invocable-only",
    "touch-and-accessibility": "user-invocable-only",
    "typography": "user-invocable-only",
    "ui-polish": "user-invocable-only",
    "ui-review": "user-invocable-only",
    "uish-add-dark-mode": "user-invocable-only",
    "uish-brand-kit": "user-invocable-only",
    "uish-canonicalize-tailwind": "user-invocable-only",
    "uish-componentize": "user-invocable-only",
    "uish-dark-mode-image": "user-invocable-only",
    "uish-design": "user-invocable-only",
    "uish-ideas": "user-invocable-only",
    "uish-make-responsive": "user-invocable-only",
    "uish-markup-from-image": "user-invocable-only"
  }
}
