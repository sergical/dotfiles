{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "skillListingBudgetFraction": 0.003,
  "attribution": {
    "commit": "Co-authored-by: Claude <claude@anthropic.com>",
    "pr": "Created with Claude Code",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [],
    "deny": ["Bash(git clean:*)"],
    "defaultMode": "auto"
  },
{{- if not (dig "profile_personal" false .) }}
  "autoMemoryEnabled": false,
{{- end }}
  "model": "opus",
  "skillOverrides": {
    "code-review": "user-invocable-only"
  },
  "statusLine": {
    "type": "command",
    "command": "{{ .chezmoi.homeDir }}/.claude/bin/ccstatusline-autocompact",
    "padding": 0,
    "refreshInterval": 10
  },
  "enabledPlugins": {
    "sentry@claude-plugins-official": {{ dig "profile_personal" false . }},
    "codex@openai-codex": {{ dig "profile_personal" false . }},
    "cc-plugin-you-should-know@builtin": true,
    "image-diet@sergical": true,
    "handoffs@sergical": true
  },
  "extraKnownMarketplaces": {
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    },
    "sergical": {
      "source": {
        "source": "github",
        "repo": "sergical/claude-plugins"
      }
    }
  },
  "sandbox": {
    "enabled": false
  },
  "effortLevel": "medium",
  "modelSettings": {
    "claude-fable-5-1": {
      "effortLevel": "high"
    },
    "claude-opus-5": {
      "effortLevel": "xhigh"
    },
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "autoCompactWindow": 200000,
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "remoteControlAtStartup": false,
  "agentPushNotifEnabled": true,
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c 'rex __internal session-start --agent claude --feature-session-naming=false 2>/dev/null || true'",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
