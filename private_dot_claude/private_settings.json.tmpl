{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "skillListingBudgetFraction": 0.002,
  "attribution": {
    "commit": "Co-authored-by: Claude <claude@anthropic.com>",
    "pr": "Created with Claude Code",
    "sessionUrl": false
  },
  "permissions": {
    "allow": [],
    "defaultMode": "auto"
  },
  "model": "opus",
  "skillOverrides": {
    "code-review": "user-invocable-only"
  },
  "statusLine": {
    "type": "command",
    "command": "{{ .chezmoi.homeDir }}/.claude/bin/ccstatusline-autocompact",
    "padding": 0,
    "refreshInterval": 10
  },
  "enabledPlugins": {
    "sentry@claude-plugins-official": true,
    "plannotator@plannotator": true,
    "codex@openai-codex": true
  },
  "extraKnownMarketplaces": {
    "plannotator": {
      "source": {
        "source": "github",
        "repo": "backnotprop/plannotator"
      }
    },
    "openai-codex": {
      "source": {
        "source": "github",
        "repo": "openai/codex-plugin-cc"
      }
    }
  },
  "sandbox": {
    "enabled": false
  },
  "effortLevel": "medium",
  "modelSettings": {
    "claude-fable-5-1": {
      "effortLevel": "high"
    },
    "claude-opus-5": {
      "effortLevel": "xhigh"
    },
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "autoCompactWindow": 200000,
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "skipWorkflowUsageWarning": true,
  "theme": "dark",
  "remoteControlAtStartup": false,
  "agentPushNotifEnabled": true
}
