{{- $gitName := promptStringOnce . "git_name" "Git user name" -}}
{{- $gitEmail := promptStringOnce . "git_email" "Git email" -}}
{{- $profileAI := promptBoolOnce . "profile_ai" "Install AI configuration" true -}}
{{- $profileEditor := promptBoolOnce . "profile_editor" "Install editor configuration" true -}}
{{- $profileAWS := promptBoolOnce . "profile_aws" "Install AWS SSO configuration" false -}}
{{- $awsProfile := "" -}}
{{- $awsSession := "" -}}
{{- $awsAccountID := "" -}}
{{- $awsStartURL := "" -}}
{{- $awsRegion := "" -}}
{{- if $profileAWS -}}
{{- $awsProfile = promptStringOnce . "aws_profile" "AWS profile name" -}}
{{- $awsSession = promptStringOnce . "aws_sso_session" "AWS SSO session name" -}}
{{- $awsAccountID = promptStringOnce . "aws_account_id" "AWS account ID" -}}
{{- $awsStartURL = promptStringOnce . "aws_sso_start_url" "AWS SSO start URL" -}}
{{- $awsRegion = promptStringOnce . "aws_region" "AWS region" "us-east-1" -}}
{{- end -}}

[data]
    git_name = {{ $gitName | quote }}
    git_email = {{ $gitEmail | quote }}
    profile_ai = {{ $profileAI }}
    profile_editor = {{ $profileEditor }}
    profile_aws = {{ $profileAWS }}
{{- if $profileAWS }}
    aws_profile = {{ $awsProfile | quote }}
    aws_sso_session = {{ $awsSession | quote }}
    aws_account_id = {{ $awsAccountID | quote }}
    aws_sso_start_url = {{ $awsStartURL | quote }}
    aws_region = {{ $awsRegion | quote }}
{{- end }}

[update]
    command = "git"
    args = ["pull", "--ff-only"]
