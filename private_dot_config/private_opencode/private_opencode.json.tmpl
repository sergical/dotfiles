{
  "$schema": "https://opencode.ai/config.json",
  "model": "openai/gpt-5.6-sol#medium",
  "default_agent": "build",
  "permissions": [
    {
      "action": "external_directory",
      "resource": "~/.agents/skills/*",
      "effect": "allow"
    },
    {
      "action": "read",
      "resource": "~/.agents/skills/*",
      "effect": "allow"
    },
    {
      "action": "edit",
      "resource": "~/.agents/skills/*",
      "effect": "deny"
    }
  ],
  "plugins": [
    {
      "package": "@plannotator/opencode@latest",
      "options": {
        "workflow": "plan-agent",
        "planningAgents": [
          "plan"
        ]
      }
    }
  ],
  "providers": {
    "openrouter": {
      "models": {
        "anthropic/claude-opus-4.8": {
          "settings": {
            "cache_control": {
              "type": "ephemeral"
            }
          }
        },
        "anthropic/claude-opus-4.8-fast": {
          "settings": {
            "cache_control": {
              "type": "ephemeral"
            }
          }
        }
      }
    }
  },
  "tool_output": {
    "max_lines": 800,
    "max_bytes": 20000
  },
  "compaction": {
    "auto": true
  },
  "experimental": {
    "subagent_depth": 1
  },
  "mcp": {
    "executor": {
      "type": "remote",
      "enabled": true,
      "url": "http://127.0.0.1:4789/mcp",
      "headers": {
        "Authorization": "Bearer {{ $p := joinPath .chezmoi.homeDir `.executor/server-control/auth.json` }}{{ if stat $p }}{{ (include $p | fromJson).token }}{{ end }}"
      }
    }
  },
  "websearch": {
    "provider": "exa"
  }
}
