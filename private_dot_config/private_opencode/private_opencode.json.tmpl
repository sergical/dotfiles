{
  "$schema": "https://opencode.ai/config.json",
  "compaction": {
    "auto": true
  },
  "default_agent": "build",
  "experimental": {
    "subagent_depth": 1
  },
  "mcp": {
    "polylane": {
      "type": "remote",
      "url": "https://mcp.polylane.com/mcp",
      "headers": {
        "x-api-key": "{{ $q := joinPath .chezmoi.homeDir `.executor/server-control/polylane-auth.json` }}{{ if stat $q }}{{ (include $q | fromJson).token }}{{ end }}"
      }
    },
    "executor": {
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {{ $p := joinPath .chezmoi.homeDir `.executor/server-control/auth.json` }}{{ if stat $p }}{{ (include $p | fromJson).token }}{{ end }}"
      },
      "type": "remote",
      "url": "http://127.0.0.1:4789/mcp"
    }
  },
  "model": "openai/gpt-5.6-sol#medium",
  "permissions": [
    {
      "action": "external_directory",
      "effect": "allow",
      "resource": "~/.agents/skills/*"
    },
    {
      "action": "read",
      "effect": "allow",
      "resource": "~/.agents/skills/*"
    },
    {
      "action": "edit",
      "effect": "deny",
      "resource": "~/.agents/skills/*"
    }
  ],
  "plugins": [
    {
      "options": {
        "planningAgents": [
          "plan"
        ],
        "workflow": "plan-agent"
      },
      "package": "@plannotator/opencode@latest"
    }
  ],
  "providers": {
    "openrouter": {
      "models": {
        "anthropic/claude-opus-4.8": {
          "settings": {
            "cache_control": {
              "type": "ephemeral"
            }
          }
        },
        "anthropic/claude-opus-4.8-fast": {
          "settings": {
            "cache_control": {
              "type": "ephemeral"
            }
          }
        }
      }
    }
  },
  "tool_output": {
    "max_bytes": 20000,
    "max_lines": 800
  },
  "websearch": {
    "provider": "exa"
  }
}
