{
  "$schema": "https://opencode.ai/config.json",
  "compaction": {
    "auto": true
  },
  "default_agent": "build",
  "experimental": {
    "subagent_depth": 1
  },
  "mcp": {
    "polylane": {
      "type": "remote",
      "url": "https://mcp.polylane.com/mcp",
      "headers": {
        "x-api-key": "{{ $q := joinPath .chezmoi.homeDir `.executor/server-control/polylane-auth.json` }}{{ if stat $q }}{{ (include $q | fromJson).token }}{{ end }}"
      }
    }
{{- with dig "executor_url" "" . }},
    "executor": {
      "enabled": true,
      "type": "remote",
      "url": {{ . | quote }}
    }
{{- end }}
{{- $uvx := lookPath "uvx" }}
{{- if and $uvx (stat "/Applications/Blender.app") }},
    "blender": {
      "enabled": true,
      "type": "local",
      "command": [
        {{ $uvx | quote }},
        "--from",
        "git+https://projects.blender.org/lab/blender_mcp.git@2cea8d566dde07fbac28a61d698909d69724e853#subdirectory=mcp",
        "blender-mcp"
      ]
    }
{{- end }}
{{- $resolve := "/Applications/DaVinci Resolve/DaVinci Resolve.app/Contents/Applications/ResolveMCP" }}
{{- if stat $resolve }},
    "davinci-resolve": {
      "enabled": true,
      "type": "local",
      "command": [
        {{ $resolve | quote }}
      ]
    }
{{- end }}
  },
  "model": "openai/gpt-5.6-sol#medium",
  "permissions": [
    {
      "action": "external_directory",
      "effect": "allow",
      "resource": "~/.agents/skills/*"
    },
    {
      "action": "read",
      "effect": "allow",
      "resource": "~/.agents/skills/*"
    },
    {
      "action": "edit",
      "effect": "deny",
      "resource": "~/.agents/skills/*"
    }
  ],
  "providers": {
    "openrouter": {
      "models": {
        "anthropic/claude-opus-4.8": {
          "settings": {
            "cache_control": {
              "type": "ephemeral"
            }
          }
        },
        "anthropic/claude-opus-4.8-fast": {
          "settings": {
            "cache_control": {
              "type": "ephemeral"
            }
          }
        }
      }
    }
  },
  "tool_output": {
    "max_bytes": 20000,
    "max_lines": 800
  },
  "websearch": {
    "provider": "exa"
  }
}
