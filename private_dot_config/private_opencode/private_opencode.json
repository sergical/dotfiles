{
  "model": "openai/gpt-5.6-sol#medium",
  "default_agent": "build",
  "instructions": [
    "/Users/sergiydybskiy/.config/opencode/ROUTING.md"
  ],
  "plugins": [
    {
      "package": "@plannotator/opencode@latest",
      "options": {
        "workflow": "plan-agent",
        "planningAgents": [
          "plan"
        ]
      }
    }
  ],
  "providers": {
    "openrouter": {
      "models": {
        "anthropic/claude-opus-4.8": {
          "settings": {
            "cache_control": {
              "type": "ephemeral"
            }
          }
        },
        "anthropic/claude-opus-4.8-fast": {
          "settings": {
            "cache_control": {
              "type": "ephemeral"
            }
          }
        }
      }
    }
  },
  "tool_output": {
    "max_lines": 800,
    "max_bytes": 20000
  },
  "compaction": {
    "auto": true
  },
  "experimental": {
    "subagent_depth": 1
  },
  "mcp": {
    "servers": {
      "excalidraw": {
        "type": "remote",
        "url": "https://api.excalidraw.com/api/v1/mcp",
        "headers": {
          "Authorization": "Bearer {env:EXCALIDRAW_API_KEY}"
        }
      },
      "linear": {
        "type": "remote",
        "url": "https://mcp.linear.app/mcp"
      },
      "mobbin": {
        "type": "remote",
        "url": "https://api.mobbin.com/mcp"
      },
      "motion": {
        "type": "remote",
        "url": "https://mcp.motion.dev"
      },
      "motion-plus": {
        "type": "remote",
        "url": "https://mcp.motion.dev/plus"
      },
      "plausible": {
        "type": "remote",
        "url": "https://plausible-mcp.sentry.dev/internal"
      },
      "sentry": {
        "type": "remote",
        "url": "https://mcp.sentry.dev/mcp"
      }
    }
  }
}
