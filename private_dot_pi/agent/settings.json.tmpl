{{- $settings := joinPath .chezmoi.homeDir ".pi/agent/settings.json" -}}
{{- $deviceId := "" -}}
{{- if stat $settings -}}{{- $current := include $settings | fromJson -}}{{- if hasKey $current "deviceId" -}}{{- $deviceId = $current.deviceId -}}{{- end -}}{{- end -}}
{
{{- if dig "profile_work" false . }}
  "defaultProvider": "openai",
  "defaultModel": "gpt-6.1-sol",
{{- else }}
  "defaultProvider": "openai-codex",
  "defaultModel": "gpt-6.1-sol",
{{- end }}
  "lastChangelogVersion": "1.3.0",
  "defaultThinkingLevel": "medium",
  "enabledModels": [
{{- if dig "profile_work" false . }}
    "openai/gpt-6.1-sol",
    "openrouter/x-ai/grok-4.6",
    "openrouter/google/gemini-3.7-flash"
{{- else }}
    "openai-codex/gpt-6.1-sol",
    "anthropic/claude-opus-5-5",
    "amazon-bedrock/global.anthropic.claude-opus-5-5",
    "amazon-bedrock/global.anthropic.claude-haiku-5-5",
    "amazon-bedrock/global.moonshotai.kimi-k3.1",
    "amazon-bedrock/qwen.qwen3-coder-next",
    "amazon-bedrock/deepseek.v3.2",
    "amazon-bedrock/openai.gpt-oss-120b-1:0",
    "amazon-bedrock/zai.glm-4.7-flash",
    "cloudflare-workers-ai/@cf/moonshotai/kimi-k2.7-code",
    "cloudflare-workers-ai/@cf/zai-org/glm-5.3-flash"
{{- end }}
  ],
  "theme": "dark"{{ with $deviceId }},
  "deviceId": {{ . | quote }}{{ end }}
}
